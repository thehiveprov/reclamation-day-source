{
  "_about": "The F2 overlay's WORLD SETTINGS (Code/client/Games/Fallout4/Interface/WorldSettings.cpp, docs/MENUS.md): NAC X's holotape settings and the host's weather. An entry's source is a global (\"global\": \"Plugin|local id\") or one of the page's own values (\"own\", kept in config\\WorldSettings.ini, defaults below). \"values\": a dropdown's options are these values of its source. \"stepper\": a slider moved one step at a time by that quest function (never written). \"call\": a function after a change or on a press; a quest's when it names one, else the script's global one; params \"{value}\" (the entry's value) and \"{name}\" (an own value). \"show\": host (not a guest on someone else's server), guest, 2287 (not in Winter of Atom), prequel; joined by +.",
  "requires": "NAC.esp",
  "own": { "fov": 0, "dofMode": 0, "dofAperture": 3, "weather": 1, "winterWeather": 36, "weatherKind": 0 },
  "pages": [
    {
      "name": "Weather",
      "items": [
        { "type": "text", "show": "guest", "text": "The host sets the world's weather, climate and time. Yours follow theirs." },
        {
          "type": "dropdown", "show": "host+2287", "own": "weather", "text": "Weather",
          "help": "Pick a weather, then load it, fade into it, or ban it from the climate. Everyone on your server gets it.",
          "options": [
            "Sunny: Clear Sky", "Sunny: Clear", "Sunny: Half Clear", "Sunny: Cloudy", "Sunny: Very Cloudy", "Sunny: Clear Overcast",
            "Overcast: Sunny", "Overcast: Bright", "Overcast: Half", "Overcast", "Overcast: Low Sky", "Overcast: Dark", "Overcast: Dark Sky",
            "Overcast: Sunny Dark", "Overcast: Very Dark",
            "Rain: Spring Rain", "Rain: Very Cloudy", "Rain: Misty", "Rain", "Rain: Heavy", "Rain: Thunder", "Rain: Dark", "Rain: Thunderstorm",
            "Fog: Mist", "Fog: Mist Overcast", "Fog: Sunny", "Fog", "Fog: Dark",
            "Snow: Misty", "Snow: Foggy", "Snow", "Snow: Snowstorm",
            "Radstorm: Polluted", "Radstorm: Radiated Fog", "Radstorm: Acid Rain", "Radstorm", "Radstorm: Ultra", "Radstorm: Sulfur Storm",
            "Radstorm: Time Warp", "Radstorm: Fallout", "Radstorm: Fire Storm", "Radstorm: Red Storm"
          ],
          "values": [1, 0, 30, 10, 20, 18, 17, 9, 31, 7, 15, 12, 13, 16, 23, 21, 40, 6, 8, 14, 19, 27, 28, 5, 22, 25, 2, 11, 41, 35, 36, 37, 32, 3, 24, 4, 34, 38, 39, 33, 29, 26]
        },
        {
          "type": "button", "show": "host+2287", "text": "Load it now",
          "call": { "script": "ReclamationDay:WorldSettings", "function": "LoadWeather", "params": ["{weather}", false] }
        },
        {
          "type": "button", "show": "host+2287", "text": "Fade into it",
          "call": { "script": "ReclamationDay:WorldSettings", "function": "LoadWeather", "params": ["{weather}", true] }
        },
        {
          "type": "button", "show": "host+2287", "text": "Ban it from the climate",
          "call": { "script": "ReclamationDay:WorldSettings", "function": "BanWeather", "params": ["{weather}", true] }
        },
        {
          "type": "button", "show": "host+2287", "text": "Allow it again",
          "call": { "script": "ReclamationDay:WorldSettings", "function": "BanWeather", "params": ["{weather}", false] }
        },
        {
          "type": "button", "show": "host+2287", "text": "Load a random weather",
          "call": { "quest": "NAC.esp|10338", "script": "NAC:ConfigScriptsLibrary", "function": "LoadRandomWeather", "params": [] }
        },
        {
          "type": "dropdown", "show": "host+prequel", "own": "winterWeather", "text": "Weather",
          "help": "Winter of Atom's weathers: clear, snow and radstorms (Blizzard is the prologue's). Everyone on your server gets it.",
          "options": [
            "Clear: Clear Sky", "Clear", "Clear: Half Clear",
            "Snow: Blizzard", "Snow: Turbulent", "Snow: Medium", "Snow: Flurry", "Snow: Light",
            "Snow: Misty", "Snow: Foggy", "Snow", "Snow: Snowstorm",
            "Radstorm: Polluted", "Radstorm: Radiated Fog", "Radstorm: Acid Rain", "Radstorm", "Radstorm: Ultra", "Radstorm: Sulfur Storm",
            "Radstorm: Fallout", "Radstorm: Red Storm"
          ],
          "values": [1, 0, 30, 100, 101, 102, 103, 104, 41, 35, 36, 37, 32, 3, 24, 4, 34, 38, 33, 26]
        },
        {
          "type": "button", "show": "host+prequel", "text": "Load it now",
          "call": { "script": "ReclamationDay:WorldSettings", "function": "LoadWeather", "params": ["{winterWeather}", false] }
        },
        {
          "type": "button", "show": "host+prequel", "text": "Fade into it",
          "call": { "script": "ReclamationDay:WorldSettings", "function": "LoadWeather", "params": ["{winterWeather}", true] }
        },
        {
          "type": "button", "show": "host+prequel", "text": "Load a random winter weather",
          "call": { "script": "ReclamationDay:WorldSettings", "function": "LoadRandomWinterWeather", "params": [] }
        },
        { "type": "section", "show": "host+2287", "text": "Kinds of weather" },
        {
          "type": "dropdown", "show": "host+2287", "own": "weatherKind", "text": "Kind of weather",
          "help": "Ban a whole kind of weather from the climate, or allow it again.",
          "options": ["Sunny", "Overcast", "Rain", "Fog", "Snow", "Radstorms"]
        },
        {
          "type": "button", "show": "host+2287", "text": "Ban this kind",
          "call": { "script": "ReclamationDay:WorldSettings", "function": "BanWeatherGroup", "params": ["{weatherKind}", true] }
        },
        {
          "type": "button", "show": "host+2287", "text": "Allow this kind again",
          "call": { "script": "ReclamationDay:WorldSettings", "function": "BanWeatherGroup", "params": ["{weatherKind}", false] }
        },
        { "type": "section", "show": "host+2287", "text": "Climate" },
        {
          "type": "dropdown", "show": "host+2287", "text": "Climate",
          "help": "Takes effect over the next two game days.",
          "options": ["Balanced (NAC's)", "Winter", "Spring", "Summer", "Fall", "Nuclear", "Seasons by the game's date"],
          "global": "NAC.esp|3EE31",
          "call": { "quest": "NAC.esp|10338", "script": "NAC:ConfigScriptsLibrary", "function": "RefreshClimate", "params": [] }
        },
        {
          "type": "switcher", "show": "host+2287", "text": "Radstorms outside hazard regions", "global": "NAC.esp|24329",
          "call": { "script": "ReclamationDay:WorldSettings", "function": "Refresh", "params": [false] }
        },
        {
          "type": "switcher", "show": "host+2287", "text": "Radiated rain", "global": "NAC.esp|2F290",
          "call": { "script": "ReclamationDay:WorldSettings", "function": "Refresh", "params": [false] }
        },
        { "type": "section", "show": "host", "text": "Time" },
        {
          "type": "dropdown", "show": "host", "text": "Timescale",
          "help": "Game time to real time. 20:1, the game's own, is 20 seconds of game time each real second.",
          "options": ["1:1 (real time)", "5:1", "8:1", "10:1", "12:1", "15:1", "20:1 (the game's)", "30:1", "60:1", "300:1", "600:1", "1200:1", "2400:1"],
          "values": [1, 5, 8, 10, 12, 15, 20, 30, 60, 300, 600, 1200, 2400],
          "global": "Fallout4.esm|3A"
        }
      ]
    },
    {
