#include "winres.h"
#include "BuildInfo.h"

// The name the library ships under (set_basename in xmake.lua)
#if defined(TARGET_FT)
#define PROGRAM_FILE_NAME "RDServer.dll"
#else
#define PROGRAM_FILE_NAME "STServer.dll"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION BUILD_VERSION_MAJOR,BUILD_VERSION_MINOR,BUILD_VERSION_PATCH,BUILD_VERSION_BUILD
PRODUCTVERSION BUILD_VERSION_MAJOR,BUILD_VERSION_MINOR,BUILD_VERSION_PATCH,BUILD_VERSION_BUILD
FILEFLAGSMASK 0x17L
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x4L
FILETYPE 0x2L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Together Team"
            VALUE "ProductName", "HIVEMIND"
            VALUE "FileDescription", "Multiplayer Server for Bethesda games"
            VALUE "FileVersion", BUILD_COMMIT
            VALUE "InternalName", PROGRAM_FILE_NAME
            VALUE "OriginalFilename", PROGRAM_FILE_NAME
            VALUE "ProductVersion",	BUILD_BRANCH "@" BUILD_COMMIT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
