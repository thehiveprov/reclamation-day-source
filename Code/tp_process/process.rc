  
#include "winres.h"
#include "BuildInfo.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION BUILD_VERSION_MAJOR,BUILD_VERSION_MINOR,BUILD_VERSION_PATCH,BUILD_VERSION_BUILD
PRODUCTVERSION BUILD_VERSION_MAJOR,BUILD_VERSION_MINOR,BUILD_VERSION_PATCH,BUILD_VERSION_BUILD
FILEFLAGSMASK 0x17L
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x4L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Together Team"
            VALUE "ProductName", "UIProcess"
            VALUE "FileDescription", "TiltedUI Worker"
            VALUE "FileVersion", BUILD_COMMIT
            VALUE "InternalName", "TPProcess.exe"
            VALUE "OriginalFilename", "TPProcess.exe"
            VALUE "ProductVersion", BUILD_COMMIT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "process.manifest"

102 ICON "resources/team.ico"